+def _identity_hub_forward(request: Request, platform: str, state: str | None) -> RedirectResponse | None:
+    """Send an Identity Hub callback, unchanged, to the hub's own callback.
+
+    The hub exchanges the code itself with this same redirect URI, so the
+    platform's exact-match check still passes. The target is fixed by
+    configuration and the platform segment is restricted to a plain id, so
+    this cannot be turned into an open redirect.
+    """
+    if not settings.IDENTITY_HUB_URL or not state or not state.startswith(IDENTITY_HUB_STATE_PREFIX):
+        return None
+    if not re.fullmatch(r"[a-z]{1,20}", platform):
+        return None
+    target = f"{settings.IDENTITY_HUB_URL.rstrip('/')}/api/auth/callback/{platform}"
+    return RedirectResponse(f"{target}?{request.url.query}", status_code=302)
+
