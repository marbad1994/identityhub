# Copy to .env on the server (never commit). See README "Configuration".
POSTGRES_PASSWORD=change-me
# Public origin, no trailing slash. Platform callbacks are {APP_ORIGIN}/api/auth/callback/<platform>.
APP_ORIGIN=https://identity.makketing.com
# Encrypts stored platform tokens. Long random string; changing it makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Platform apps. Same variable names as SocialPostAPI, so the same values can be copied.
# A platform shows up for sign-in once both of its values are set.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: Facebook Login for Business configuration id (shows the Page picker).
FACEBOOK_LOGIN_CONFIG_ID=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
