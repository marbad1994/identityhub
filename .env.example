# Copy to .env on the server (never commit). See README "Configuration".
POSTGRES_PASSWORD=change-me
# Interface for port 8316. 0.0.0.0 = reachable on the server's public IP; 127.0.0.1 = proxy only.
IDENTITYHUB_BIND=0.0.0.0
# Public origin, no trailing slash. Platform callbacks are {APP_ORIGIN}/api/auth/callback/<platform>.
APP_ORIGIN=https://identity.makketing.com
# Encrypts stored platform tokens. Long random string; changing it makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Outgoing email: sign-up confirmation, password reset, security notices.
# Email and password sign-in only appears once SMTP_HOST and SMTP_FROM_EMAIL are set.
# Same names as SocialPostAPI. Port 465 uses TLS directly; others require STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@makketing.com
SMTP_USE_TLS=true

# Optional: comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted for rate limiting. Defaults to loopback and private ranges (Docker, Caddy).
# TRUSTED_PROXIES=

# Platform apps. Same variable names as SocialPostAPI, so the same values can be copied.
# A platform shows up for sign-in once both of its values are set.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: Facebook Login for Business configuration id (shows the Page picker).
FACEBOOK_LOGIN_CONFIG_ID=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
